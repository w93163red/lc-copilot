{
  "manifest_version": 3,
  "name": "LeetCode Copilot",
  "version": "0.1.0",
  "description": "在侧边栏为当前 LeetCode 题目生成循序渐进的提示和完整代码。",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://leetcode.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "打开 LeetCode Copilot"
  }
}
